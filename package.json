{
  "name": "dam-good-maps",
  "version": "0.2.0",
  "private": true,
  "description": "Timberborn map generator: pick settings, preview the map, download a .timber file that plays in Timberborn 1.1.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen": "tsx tools/gen.ts",
    "oracle": "tsx tools/oracle.ts",
    "bench": "tsx tools/bench.ts",
    "bench:water": "tsx tools/bench.ts --water",
    "batch": "tsx tools/batch.ts",
    "fixtures": "python tools/export-fixtures.py"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
